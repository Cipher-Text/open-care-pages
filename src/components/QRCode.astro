---
import QRCode from 'qrcode';

const {
  value = '',
  label = 'QR Code',
  size = 180,
  downloadName = 'open-care-qr'
} = Astro.props;

const uid = `qr-${Math.random().toString(36).slice(2, 9)}`;

// Generate QR code as data URL at build time (server-side)
let qrDataUrl = '';
if (value) {
  try {
    qrDataUrl = await QRCode.toDataURL(value, { 
      width: size, 
      margin: 2,
      color: { dark: '#000000', light: '#ffffff' }
    });
  } catch (err) {
    console.error('QR Code generation failed:', err);
  }
}
---
<div
  id={uid}
  class="qr-card"
  data-qr-root="true"
  data-qr-value={value}
  data-qr-size={size}
  data-qr-name={downloadName}
>
  <div class="qr-preview">
    {qrDataUrl ? (
      <img src={qrDataUrl} alt={label} width={size} height={size} class="qr-image" />
    ) : (
      <canvas width={size} height={size} aria-label={label}></canvas>
    )}
  </div>
  <div class="qr-actions">
    <a href={qrDataUrl} download={`${downloadName}.png`} class="qr-action">Download PNG</a>
  </div>
</div>

<style is:global>
  .qr-card {
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
    align-items: center;
    text-align: center;
  }

  .qr-preview {
    border: 1px solid #e2e8f0;
    border-radius: 1rem;
    padding: 0.75rem;
    background: #ffffff;
  }

  .qr-preview canvas,
  .qr-preview .qr-image {
    display: block;
  }

  .qr-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    justify-content: center;
  }

  .qr-action {
    border: 1px solid #e2e8f0;
    border-radius: 999px;
    padding: 0.35rem 0.85rem;
    font-size: 0.75rem;
    font-weight: 600;
    color: #0f172a;
    text-decoration: none;
  }

  .qr-action:hover {
    border-color: #cbd5f5;
  }
</style>
