                <span class="lang bn">{localeLabels.bn.chatOnWhatsApp}</span>
              </a>
            </div>
          )}
          {showFlags.vcard && (
            <div class="mt-5">
              <p class="text-xs font-semibold uppercase tracking-wide text-slate-500">
                <span class="lang en">{localeLabels.en.saveContact}</span>
                <span class="lang bn">{localeLabels.bn.saveContact}</span>
              </p>
              <a
                href={vcardHref}
                download={`${vcardFileBase}.vcf`}
                class="mt-2 inline-flex rounded-full border border-slate-200 px-4 py-2 text-xs font-semibold text-slate-700 hover:border-slate-300"
              >
                <span class="lang en">{localeLabels.en.downloadVcard}</span>
                <span class="lang bn">{localeLabels.bn.downloadVcard}</span>
              </a>
            </div>
          )}
        </div>
        {showFlags.quickBooking && (
        <div class="rounded-2xl border border-emerald-200 bg-emerald-50 p-6">
          <h3 class="text-lg font-semibold">
            <span class="lang en">{localeLabels.en.quickBooking}</span>
            <span class="lang bn">{localeLabels.bn.quickBooking}</span>
          </h3>
          <p class="mt-2 text-sm text-emerald-700">
            <span class="lang en">{localeLabels.en.quickBookingDesc}</span>
            <span class="lang bn">{localeLabels.bn.quickBookingDesc}</span>
          </p>
          <div class="mt-4 flex flex-col gap-3">
            <a
              href={bookingHref}
              class="rounded-full bg-emerald-600 px-5 py-2 text-sm font-semibold text-white text-center"
            >
              <span class="lang en">{localeLabels.en.bookAppointment}</span>
              <span class="lang bn">{localeLabels.bn.bookAppointment}</span>
            </a>
            {whatsappLink && (
              <a
                href={whatsappLink}
                class="rounded-full border border-emerald-200 px-5 py-2 text-sm font-semibold text-emerald-700 text-center"
              >
                <span class="lang en">{localeLabels.en.chatOnWhatsApp}</span>
                <span class="lang bn">{localeLabels.bn.chatOnWhatsApp}</span>
              </a>
            )}
            {bookingUrl && (
              <a
                href={bookingUrl}
                class="rounded-full border border-emerald-200 px-5 py-2 text-sm font-semibold text-emerald-700 text-center"
              >
                <span class="lang en">{localeLabels.en.bookOnline}</span>
                <span class="lang bn">{localeLabels.bn.bookOnline}</span>
              </a>
            )}
            {derivedPhone && (
              <a
                href={`tel:${derivedPhone}`}
                class="rounded-full border border-emerald-200 px-5 py-2 text-sm font-semibold text-emerald-700 text-center"
              >
                <span class="lang en">{localeLabels.en.callOffice}</span>
                <span class="lang bn">{localeLabels.bn.callOffice}</span>
              </a>
            )}
          </div>
          {showFlags.qr && (
            <div class="mt-6">
              <p class="text-xs font-semibold uppercase tracking-wide text-emerald-700">
                <span class="lang en">{localeLabels.en.shareQr}</span>
                <span class="lang bn">{localeLabels.bn.shareQr}</span>
              </p>
              <QRCode value={bookingUrl || pageUrl} label="Doctor QR code" downloadName="doctor-qr" size={180} />
            </div>
          )}
          {showFlags.vcard && (
            <div class="mt-6">
              <p class="text-xs font-semibold uppercase tracking-wide text-emerald-700">
                <span class="lang en">{localeLabels.en.saveContact}</span>
                <span class="lang bn">{localeLabels.bn.saveContact}</span>
              </p>
              <a
                href={vcardHref}
                download={`${vcardFileBase}.vcf`}
                class="mt-2 inline-flex rounded-full border border-emerald-200 px-4 py-2 text-xs font-semibold text-emerald-700 hover:border-emerald-300"
              >
                <span class="lang en">{localeLabels.en.downloadVcard}</span>
                <span class="lang bn">{localeLabels.bn.downloadVcard}</span>
              </a>
            </div>
          )}
        </div>
        )}
      </div>
    </section>
  </main>
  {whatsappLink && (
    <div class="fixed inset-x-0 bottom-0 z-50 border-t border-emerald-200 bg-white/95 px-4 py-3 shadow-lg backdrop-blur md:hidden">
      <a
        href={whatsappLink}
        class="flex w-full items-center justify-center rounded-full bg-emerald-600 px-4 py-3 text-sm font-semibold text-white"
      >
        <span class="lang en">{localeLabels.en.chatOnWhatsApp}</span>
        <span class="lang bn">{localeLabels.bn.chatOnWhatsApp}</span>
      </a>
    </div>
  )}

  <footer class="border-t border-slate-200 bg-slate-50">
    <div class="mx-auto w-full max-w-6xl px-4 py-10 text-sm text-slate-600">
      <p class="text-xs text-slate-500">
        Medical information is provided for general education only and is not a substitute for professional medical advice,
        diagnosis, or treatment. Always seek the advice of your physician or qualified health provider with any questions.
      </p>
      {showFlags.socialLinks && social.length > 0 && (
        <div class="mt-4 flex flex-wrap gap-3">
          {social.map((item) => (
            <a
              href={item.url}
              class="text-slate-600 hover:text-slate-900"
              target="_blank"
              rel="noreferrer"
            >
              {item.label}
            </a>
          ))}
        </div>
      )}
      <p class="mt-4">&copy; {year} {title}. All rights reserved.</p>
    </div>
  </footer>

  {!whatsappLink && (
    <div class="fixed bottom-4 left-4 right-4 z-40 md:hidden">
      <a
        href={bookingHref}
        class="flex w-full items-center justify-center rounded-full bg-emerald-600 px-5 py-3 text-sm font-semibold text-white shadow-lg"
      >
        <span class="lang en">{localeLabels.en.bookAppointment}</span>
        <span class="lang bn">{localeLabels.bn.bookAppointment}</span>
      </a>
    </div>
  )}
  {hasLocalization && (
    <script is:inline define:vars={{ defaultLocale }}>
      (() => {
        const storageKey = 'oc-lang';
        const defaultLang = defaultLocale;
        const root = document.documentElement;
        const buttons = Array.from(document.querySelectorAll('[data-lang-toggle]'));
        if (!buttons.length) return;
        const applyLang = (lang) => {
          root.dataset.lang = lang;
          root.setAttribute('lang', lang);
          buttons.forEach((btn) => {
            btn.classList.toggle('is-active', btn.getAttribute('data-lang-toggle') === lang);
          });
          try {
            localStorage.setItem(storageKey, lang);
          } catch {}
        };
        let saved = null;
        try {
          saved = localStorage.getItem(storageKey);
        } catch {}
        applyLang(saved || defaultLang);
        buttons.forEach((btn) => {
          btn.addEventListener('click', () => applyLang(btn.getAttribute('data-lang-toggle')));
        });
      })();
    </script>
  )}
</BaseLayout>
