---
import BaseLayout from './BaseLayout.astro';
import QRCode from '../components/QRCode.astro';

type Degree = {
  title: string;
  institution?: string;
  year?: string;
};

type Affiliations = {
  worksAt?: string[];
  visitsAt?: string[];
  roles?: string[];
};

type LocationSchedule = {
  day: string;
  time: string;
};

type LocationCard = {
  name: string;
  address: string;
  schedule?: LocationSchedule[];
  feeRange?: string;
  remarks?: string;
  phone?: string;
  email?: string;
  whatsapp?: string;
  bookingUrl?: string;
  mapUrl?: string;
  mapEmbed?: string;
};

type ReviewLink = {
  label: string;
  url: string;
};

type FaqItem = {
  question: string;
  answer: string;
  category?: string;
};

type SocialLink = {
  label: string;
  url: string;
};

type LocalizedFaq = {
  question: string;
  answer: string;
  category?: string;
};

type LocalizedLocation = {
  name: string;
  address: string;
  schedule?: LocationSchedule[];
  feeRange?: string;
  remarks?: string;
  phone?: string;
  email?: string;
  whatsapp?: string;
  bookingUrl?: string;
  mapUrl?: string;
  mapEmbed?: string;
};

type Localization = {
  defaultLocale?: string;
  locales?: {
    bn?: {
      title?: string;
      specialty?: string;
      location?: string;
      contact?: string;
      valueProp?: string;
      about?: string;
      carePhilosophy?: string[];
      focusAreas?: string[];
      consultationModes?: string[];
      appointmentHours?: string;
      emergencyNote?: string;
      faqs?: LocalizedFaq[];
      locations?: LocalizedLocation[];
    };
  };
};

const { entry } = Astro.props;
const {
  title,
  specialty,
  bmdcNumber,
  location,
  contact,
  seo,
  phone,
  email,
  whatsapp,
  bookingUrl,
  headshot,
  verified,
  licenseStatus,
  valueProp,
  trust,
  show,
  carePhilosophy,
  focusAreas,
  consultationModes,
  degrees,
  affiliations,
  publications,
  awards,
  media,
  locations,
  reviewLinks,
  faqs,
  appointmentHours,
  emergencyNote,
  socialLinks,
  localization
} = entry.data;

const description = seo?.description || `${title} — ${specialty || 'Doctor'} in ${location}.`;

const localizationData = (localization || {}) as Localization;
const localizedBn = localizationData.locales?.bn || {};
const hasLocalizedBn = Object.keys(localizedBn || {}).length > 0;
const defaultLocale = localizationData.defaultLocale === 'bn' ? 'bn' : 'en';

const contactValue = contact || '';
const contactParts = (contactValue ? contactValue.split('·').map((part: string) => part.trim()) : []) as string[];
const derivedPhone = phone || contactParts[0] || '';
const derivedEmail = email || contactParts[1] || '';
const derivedWhatsApp = whatsapp || '';
const whatsappPrefillMessage = 'Hello Doctor, I found your profile on Open Care and would like to book an appointment.';
const getWhatsAppLink = (raw = '') => {
  if (!raw) return '';
  if (raw.startsWith('http')) {
    try {
      const url = new URL(raw);
      if (!url.searchParams.get('text')) {
        url.searchParams.set('text', whatsappPrefillMessage);
      }
      return url.toString();
    } catch {
      return raw;
    }
  }
  const digits = raw.replace(/[^0-9]/g, '');
  return digits ? `https://wa.me/${digits}?text=${encodeURIComponent(whatsappPrefillMessage)}` : '';
};
const whatsappLink = getWhatsAppLink(derivedWhatsApp);
const escapeVCardValue = (value = '') => value
  .replace(/\\/g, '\\\\')
  .replace(/\n/g, '\\n')
  .replace(/;/g, '\\;')
  .replace(/,/g, '\\,');
const nameWithoutTitle = title.replace(/^Dr\.?\s+/i, '').trim();
const nameParts = nameWithoutTitle ? nameWithoutTitle.split(/\s+/) : [];
const lastName = nameParts.length > 1 ? nameParts[nameParts.length - 1] : (nameParts[0] || '');
const firstName = nameParts.length > 1 ? nameParts.slice(0, -1).join(' ') : '';
const organization = affiliations?.worksAt?.[0] || '';

const heroValueProp = valueProp || description;
const heroValuePropBn = localizedBn.valueProp || heroValueProp;
const primaryLocation = location;
const primaryLocationBn = localizedBn.location || primaryLocation;
const titleBn = localizedBn.title || title;
const specialtyBn = localizedBn.specialty || specialty;
const specialtyFallbackEn = specialty || 'Doctor';
const specialtyFallbackBn = specialtyBn || 'ডাক্তার';
const appointmentHoursBn = localizedBn.appointmentHours || appointmentHours;
const emergencyNoteBn = localizedBn.emergencyNote || emergencyNote;
const carePhilosophyBn = localizedBn.carePhilosophy || carePhilosophy;
const bookingHref = bookingUrl || '#contact';
const primaryCtaHref = whatsappLink || bookingHref;
const primaryCtaIsWhatsApp = Boolean(whatsappLink);
const pageUrl = Astro.url?.href || '';
const showFlags = {
  trust: show?.trust !== false,
  carePhilosophy: show?.carePhilosophy !== false,
  services: show?.services !== false,
  expertise: show?.expertise !== false,
  locations: show?.locations !== false,
  reviews: show?.reviews !== false,
  faqs: show?.faqs !== false,
  qr: show?.qr !== false,
  vcard: show?.vcard !== false,
  quickBooking: show?.quickBooking !== false,
  socialLinks: show?.socialLinks !== false,
  languageToggle: show?.languageToggle !== false
};

const trustChipsEn = [];
const trustChipsBn = [];
if (trust?.boardCertified) {
  trustChipsEn.push('Board certified');
  trustChipsBn.push('বোর্ড সার্টিফায়েড');
}
if (verified) {
  trustChipsEn.push('Verified');
  trustChipsBn.push('ভেরিফায়েড');
}
if (trust?.hospitalPrivileges) {
  trustChipsEn.push('Hospital privileges');
  trustChipsBn.push('হাসপাতাল অনুমোদন');
}
if (trust?.cme) {
  trustChipsEn.push('Ongoing CME');
  trustChipsBn.push('নিয়মিত সিএমই');
}
if (trust?.bmdcRegistered) {
  trustChipsEn.push('BMDC registered');
  trustChipsBn.push('বিএমডিসি নিবন্ধিত');
}
if (trust?.governmentCadre) {
  trustChipsEn.push('BCS (Health)');
  trustChipsBn.push('বিসিএস (স্বাস্থ্য)');
}
if (trust?.postgraduateTraining) {
  trustChipsEn.push('Postgraduate training');
  trustChipsBn.push('পোস্টগ্র্যাজুয়েট প্রশিক্ষণ');
}
if (trust?.languages?.length) {
  trustChipsEn.push(`Languages: ${trust.languages.join(', ')}`);
  trustChipsBn.push(`ভাষা: ${trust.languages.join(', ')}`);
}

const servicesList = ((focusAreas?.length ? focusAreas : []) as string[]).slice(0, 12);
const servicesListBn = ((localizedBn.focusAreas?.length ? localizedBn.focusAreas : servicesList) as string[]).slice(0, 12);
const modes = (consultationModes?.length ? consultationModes : []) as string[];
const modesBn = (localizedBn.consultationModes?.length ? localizedBn.consultationModes : modes) as string[];

const publicationsList = (publications?.length ? publications : []) as string[];
const awardsList = (awards?.length ? awards : []) as string[];
const mediaList = (media?.length ? media : []) as string[];
const hasCredExtras = publicationsList.length || awardsList.length || mediaList.length;
const degreesList = (degrees?.length ? degrees : []) as Degree[];
const affiliationsData = (affiliations || {}) as Affiliations;
const hasExpertise = Boolean(degreesList.length || affiliationsData.worksAt?.length || affiliationsData.visitsAt?.length || affiliationsData.roles?.length || hasCredExtras);

const locationCards = (locations?.length
  ? locations
  : primaryLocation
    ? [{
        name: 'Primary Practice',
        address: primaryLocation,
        schedule: [],
        feeRange: '',
        remarks: '',
        phone: derivedPhone,
        email: derivedEmail,
        whatsapp: derivedWhatsApp,
        bookingUrl
      }]
    : []) as LocationCard[];
const localizedLocationCards = (localizedBn.locations?.length
  ? localizedBn.locations
  : locationCards) as LocalizedLocation[];

const reviews = (reviewLinks?.length ? reviewLinks : []) as ReviewLink[];
const faqList = (faqs?.length ? faqs : []) as FaqItem[];
const faqListBn = (localizedBn.faqs?.length ? localizedBn.faqs : faqList) as LocalizedFaq[];

const groupedFaqs = faqList.reduce((acc: Record<string, FaqItem[]>, item: FaqItem) => {
  const category = item.category || 'General';
  if (!acc[category]) acc[category] = [];
  acc[category].push(item);
  return acc;
}, {});
const groupedFaqsBn = faqListBn.reduce((acc: Record<string, LocalizedFaq[]>, item: LocalizedFaq) => {
  const category = item.category || 'General';
  if (!acc[category]) acc[category] = [];
  acc[category].push(item);
  return acc;
}, {});

const social = (socialLinks?.length ? socialLinks : []) as SocialLink[];
const year = new Date().getFullYear();

const hasServices = showFlags.services && (servicesList.length > 0 || servicesListBn.length > 0);
const hasLocations = showFlags.locations && (locationCards.length > 0 || localizedLocationCards.length > 0);
const hasFaqs = showFlags.faqs && (faqList.length > 0 || faqListBn.length > 0);
const hasLocalization = showFlags.languageToggle && hasLocalizedBn;
const vcardLines = [
  'BEGIN:VCARD',
  'VERSION:3.0',
  `FN:${escapeVCardValue(title)}`,
  `N:${escapeVCardValue(lastName)};${escapeVCardValue(firstName)};;;`,
  specialty ? `TITLE:${escapeVCardValue(specialty)}` : '',
  organization ? `ORG:${escapeVCardValue(organization)}` : '',
  derivedPhone ? `TEL;TYPE=WORK,VOICE:${escapeVCardValue(derivedPhone)}` : '',
  derivedEmail ? `EMAIL;TYPE=WORK:${escapeVCardValue(derivedEmail)}` : '',
  (bookingUrl || pageUrl) ? `URL:${escapeVCardValue(bookingUrl || pageUrl)}` : '',
  primaryLocation ? `ADR;TYPE=WORK:;;${escapeVCardValue(primaryLocation)};;;;` : '',
  bmdcNumber ? `NOTE:BMDC ${escapeVCardValue(bmdcNumber)}` : '',
  'END:VCARD'
].filter(Boolean);
const vcardHref = `data:text/vcard;charset=utf-8,${encodeURIComponent(vcardLines.join('\r\n'))}`;
const vcardFileBase = entry.slug ? `${entry.slug}-contact` : 'doctor-contact';

const yearsOfExperience = degrees?.length > 0
  ? new Date().getFullYear() - parseInt(degreesList[degreesList.length - 1]?.year || '2020')
  : null;

const localeLabels = {
  en: {
    navAbout: 'About',
    navServices: 'Services',
    navExpertise: 'Expertise',
    navLocations: 'Locations',
    navFaq: 'FAQ',
    navContact: 'Contact',
    verified: 'Verified Doctor',
    trusted: 'Trusted Care',
    heroSpecialtyFallback: 'Medical Specialist',
    primaryPractice: 'Primary practice',
    acceptingNewPatients: 'Accepting new patients',
    bookAppointment: 'Book Appointment',
    chatOnWhatsApp: 'Chat on WhatsApp',
    bookOnline: 'Book Online',
    call: 'Call',
    email: 'Email',
    yearsExperience: 'Years Experience',
    responseTime: 'Fast Response',
    onlineConsult: 'Online Available',
    sameDaySlots: 'Same-Day Slots',
    about: 'About',
    whyChoose: 'Why Patients Choose Me',
    carePhilosophy: 'Care philosophy',
    servicesTitle: 'Services & Conditions',
    expertiseTitle: 'Expertise & Credentials',
    educationTraining: 'Education & Training',
    affiliationsTitle: 'Affiliations',
    worksAt: 'Works at',
    visitsAt: 'Visits at',
    instituteRoles: 'Institute roles',
    publications: 'Publications',
    awards: 'Awards',
    media: 'Media',
    locationsTitle: 'Practice Locations',
    locationsScheduleTitle: 'Practice Locations & Schedule',
    reviewsTitle: 'Reviews & Links',
    reviewsEmpty: 'Reviews coming soon.',
    faqTitle: 'FAQ',
    faqHeading: 'Frequently Asked Questions',
    contactTitle: 'Contact & Booking',
    quickBooking: 'Quick booking',
    quickBookingDesc: 'Reserve a visit in just a few steps.',
    shareQr: 'Share via QR',
    saveContact: 'Save contact',
    scheduleFallback: 'Schedule available by appointment.',
    feeRange: 'Fee range',
    remarks: 'Remarks',
    phone: 'Phone',
    whatsapp: 'WhatsApp',
    hours: 'Hours',
    emergencyNote: 'Emergency',
    locationsDay: 'Day',
    locationsTime: 'Time',
    map: 'Map',
    downloadVcard: 'Download vCard',
    callOffice: 'Call Office',
    bookAppointmentOnline: 'Book Appointment',
    reviews: 'Reviews'
  },
  bn: {
    navAbout: 'পরিচিতি',
    navServices: 'সেবা',
    navExpertise: 'দক্ষতা',
    navLocations: 'চেম্বার',
    navFaq: 'প্রশ্নোত্তর',
    navContact: 'যোগাযোগ',
    verified: 'ভেরিফায়েড ডাক্তার',
    trusted: 'বিশ্বস্ত সেবা',
    heroSpecialtyFallback: 'মেডিক্যাল স্পেশালিস্ট',
    primaryPractice: 'প্রধান চেম্বার',
    acceptingNewPatients: 'নতুন রোগী নেওয়া হচ্ছে',
    bookAppointment: 'অ্যাপয়েন্টমেন্ট বুক করুন',
    chatOnWhatsApp: 'হোয়াটসঅ্যাপে কথা বলুন',
    bookOnline: 'অনলাইনে বুক করুন',
    call: 'কল করুন',
    email: 'ইমেইল',
    yearsExperience: 'বছর অভিজ্ঞতা',
    responseTime: 'দ্রুত সাড়া',
    onlineConsult: 'অনলাইন সুবিধা',
    sameDaySlots: 'একই দিনের স্লট',
    about: 'পরিচিতি',
    whyChoose: 'রোগীরা কেন আমাকে বেছে নেন',
    carePhilosophy: 'চিকিৎসা দর্শন',
    servicesTitle: 'সেবা ও সমস্যা',
    expertiseTitle: 'দক্ষতা ও ক্রেডেনশিয়াল',
    educationTraining: 'শিক্ষা ও প্রশিক্ষণ',
    affiliationsTitle: 'সংযুক্তি',
    worksAt: 'কর্মস্থল',
    visitsAt: 'চেম্বার',
    instituteRoles: 'প্রতিষ্ঠানের ভূমিকা',
    publications: 'প্রকাশনা',
    awards: 'পুরস্কার',
    media: 'মিডিয়া',
    locationsTitle: 'চেম্বারসমূহ',
    locationsScheduleTitle: 'চেম্বার ও সময়সূচি',
    reviewsTitle: 'রিভিউ ও লিংক',
    reviewsEmpty: 'রিভিউ শিগগিরই আসছে।',
    faqTitle: 'প্রশ্নোত্তর',
    faqHeading: 'সাধারণ প্রশ্ন',
    contactTitle: 'যোগাযোগ ও বুকিং',
    quickBooking: 'দ্রুত বুকিং',
    quickBookingDesc: 'কয়েক ধাপে সাক্ষাৎ সংরক্ষণ করুন।',
    shareQr: 'কিউআর দিয়ে শেয়ার',
    saveContact: 'কন্ট্যাক্ট সেভ করুন',
    scheduleFallback: 'সময়সূচি অ্যাপয়েন্টমেন্ট অনুযায়ী।',
    feeRange: 'ফি',
    remarks: 'মন্তব্য',
    phone: 'ফোন',
    whatsapp: 'হোয়াটসঅ্যাপ',
    hours: 'সময়',
    emergencyNote: 'জরুরি',
    locationsDay: 'দিন',
    locationsTime: 'সময়',
    map: 'ম্যাপ',
    downloadVcard: 'ভিকার্ড ডাউনলোড',
    callOffice: 'অফিসে কল করুন',
    bookAppointmentOnline: 'অ্যাপয়েন্টমেন্ট বুক করুন',
    reviews: 'রিভিউ'
  }
};

const getParagraphs = (text = '') => text
  .split(/\n{2,}/)
  .map((paragraph) => paragraph.trim())
  .filter(Boolean);

const primaryCtaLabelEn = primaryCtaIsWhatsApp ? localeLabels.en.chatOnWhatsApp : localeLabels.en.bookAppointment;
const primaryCtaLabelBn = primaryCtaIsWhatsApp ? localeLabels.bn.chatOnWhatsApp : localeLabels.bn.bookAppointment;
---
<BaseLayout title={seo?.title || title} description={description} lang={defaultLocale} dataLang={defaultLocale}>
  <style is:global>
    html {
      scroll-behavior: smooth;
    }

    details summary::-webkit-details-marker {
      display: none;
    }

    .lang-toggle {
      border: 1px solid #e2e8f0;
      padding: 0.35rem 0.6rem;
      border-radius: 9999px;
      font-size: 0.7rem;
      font-weight: 600;
      text-transform: uppercase;
      letter-spacing: 0.08em;
      color: #475569;
      background: #fff;
      transition: all 0.2s ease;
    }

    .lang-toggle:hover {
      border-color: #a7f3d0;
      background: #f0fdf4;
    }

    .lang-toggle.is-active {
      border-color: #a7f3d0;
      background: #ecfdf5;
      color: #047857;
    }

    html[data-lang='en'] .lang.bn,
    html[data-lang='bn'] .lang.en {
      display: none !important;
    }

    html[data-lang='en'] [data-lang-toggle='en'],
    html[data-lang='bn'] [data-lang-toggle='bn'] {
      display: none !important;
    }

    /* Fade-in animations */
    @keyframes fadeInUp {
      from {
        opacity: 0;
        transform: translateY(20px);
      }
      to {
        opacity: 1;
        transform: translateY(0);
      }
    }

    @keyframes pulse {
      0%, 100% {
        opacity: 1;
      }
      50% {
        opacity: 0.7;
      }
    }

    .fade-in-section {
      animation: fadeInUp 0.6s ease-out;
    }

    .trust-chip {
      animation: fadeInUp 0.4s ease-out backwards;
    }

    .trust-chip:nth-child(1) { animation-delay: 0.1s; }
    .trust-chip:nth-child(2) { animation-delay: 0.2s; }
    .trust-chip:nth-child(3) { animation-delay: 0.3s; }
    .trust-chip:nth-child(4) { animation-delay: 0.4s; }
    .trust-chip:nth-child(5) { animation-delay: 0.5s; }

    .verified-badge {
      animation: pulse 2s ease-in-out infinite;
    }

    /* Hover effects */
    .service-card,
    .location-card,
    .faq-item {
      transition: all 0.3s ease;
    }

    .service-card:hover {
      transform: translateY(-4px);
      box-shadow: 0 10px 25px -5px rgba(0, 0, 0, 0.1), 0 8px 10px -6px rgba(0, 0, 0, 0.1);
    }

    .location-card:hover {
      box-shadow: 0 12px 30px -8px rgba(16, 185, 129, 0.2);
    }

    .cta-button {
      transition: all 0.2s ease;
    }

    .cta-button:hover {
      transform: scale(1.02);
    }

    .cta-button:active {
      transform: scale(0.98);
    }

    /* FAQ search styling */
    .faq-search {
      transition: all 0.3s ease;
    }

    .faq-search:focus {
      box-shadow: 0 0 0 3px rgba(16, 185, 129, 0.1);
    }

    /* Stats bar styling */
    .stats-bar {
      background: linear-gradient(to right, #ecfdf5, #f0fdf4);
      border-left: 4px solid #10b981;
    }

    .stat-item {
      position: relative;
    }

    .stat-item:not(:last-child)::after {
      content: '';
      position: absolute;
      right: 0;
      top: 50%;
      transform: translateY(-50%);
      height: 60%;
      width: 1px;
      background: linear-gradient(to bottom, transparent, #d1fae5, transparent);
    }

    /* Urgency badge */
    .urgency-badge {
      animation: pulse 2s cubic-bezier(0.4, 0, 0.6, 1) infinite;
    }

    @keyframes slideInRight {
      from {
        opacity: 0;
        transform: translateX(20px);
      }
      to {
        opacity: 1;
        transform: translateX(0);
      }
    }

    .slide-in-right {
      animation: slideInRight 0.5s ease-out;
    }

    /* Scroll progress bar */
    .scroll-progress {
      position: fixed;
      top: 0;
      left: 0;
      height: 3px;
      background: linear-gradient(to right, #10b981, #14b8a6);
      transform-origin: left;
      z-index: 9999;
      transition: transform 0.1s ease-out;
    }
  </style>

  <div class="scroll-progress" id="scroll-progress"></div>

  <header class="sticky top-0 z-40 bg-white/95 backdrop-blur border-b border-slate-200">
    <div class="mx-auto flex w-full max-w-6xl items-center justify-between gap-4 px-4 py-3">
      <div>
        <p class="text-sm font-semibold text-slate-600">
          <span class="lang en">
            {specialtyFallbackEn}
            {bmdcNumber && <span> · BMDC: {bmdcNumber}</span>}
          </span>
          <span class="lang bn">
            {specialtyFallbackBn}
            {bmdcNumber && <span> · বিএমডিসি: {bmdcNumber}</span>}
          </span>
        </p>
        <p class="text-lg font-semibold text-slate-900">
          <span class="lang en">{title}</span>
          <span class="lang bn">{titleBn}</span>
        </p>
      </div>
      <nav class="hidden items-center gap-6 text-sm font-medium text-slate-600 md:flex" aria-label="Primary">
        <a href="#about" class="hover:text-slate-900">
          <span class="lang en">{localeLabels.en.navAbout}</span>
          <span class="lang bn">{localeLabels.bn.navAbout}</span>
        </a>
        {hasServices && (
          <a href="#services" class="hover:text-slate-900">
            <span class="lang en">{localeLabels.en.navServices}</span>
            <span class="lang bn">{localeLabels.bn.navServices}</span>
          </a>
        )}
        {hasExpertise && (
          <a href="#expertise" class="hover:text-slate-900">
            <span class="lang en">{localeLabels.en.navExpertise}</span>
            <span class="lang bn">{localeLabels.bn.navExpertise}</span>
          </a>
        )}
        {hasLocations && (
          <a href="#locations" class="hover:text-slate-900">
            <span class="lang en">{localeLabels.en.navLocations}</span>
