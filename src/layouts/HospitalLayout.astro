---
import BaseLayout from './BaseLayout.astro';

const { entry } = Astro.props;
const {
  title,
  services,
  location,
  contact,
  seo,
  tagline,
  phone,
  email,
  appointmentPhone,
  emergencyPhone,
  visitingHours,
  bookingUrl,
  mapUrl,
  mapEmbed,
  departments,
  facilities,
  diagnostics,
  insurance,
  accreditations,
  stats,
  featuredDoctors,
  show,
  socialLinks
} = entry.data;

const description = seo?.description || `${title} - ${services?.[0] || 'Hospital'} in ${location}.`;
const contactParts = contact ? contact.split(/\u00b7|\/|\|/).map((part: string) => part.trim()) : [];
const displayPhone = phone || appointmentPhone || contactParts[0] || 'Call for appointments';
const displayEmail = email || contactParts[1] || 'Contact for email details';
const heroTagline = tagline || seo?.description || `Comprehensive care in ${location}.`;

const departmentList = departments?.length
  ? departments
  : (services || []).map((service) => ({
      name: service,
      summary: `Comprehensive ${service.toLowerCase()} services with dedicated teams.`
    }));

const statsList = stats || [];
const facilityList = facilities || [];
const diagnosticsList = diagnostics || [];
const insuranceList = insurance || [];
const accreditationList = accreditations || [];
const socialList = socialLinks || [];

const primaryCtaHref = bookingUrl || '#contact';
const secondaryCtaHref = mapUrl || '#find-us';
const emergencyLine = emergencyPhone || '';
const hoursValue = visitingHours || '24/7 emergency and inpatient care';
const mapCtaHref = mapUrl || '#contact';
const sectionEnabled = (flag: boolean | '' | undefined) => flag !== false;
const showHero = sectionEnabled(show?.hero);
const showEmergency = sectionEnabled(show?.emergency);
const showOverview = sectionEnabled(show?.overview);
const showDepartments = sectionEnabled(show?.departments);
const showFacilities = sectionEnabled(show?.facilities);
const showDiagnostics = sectionEnabled(show?.diagnostics);
const showInsurance = sectionEnabled(show?.insurance);
const showAccreditations = sectionEnabled(show?.accreditations);
const showDoctors = sectionEnabled(show?.doctors);
const showContact = sectionEnabled(show?.contact);
const showMap = sectionEnabled(show?.map);
const showCta = sectionEnabled(show?.cta);
const showFooter = sectionEnabled(show?.footer);
---
<BaseLayout title={seo?.title || title} description={description}>
  <style is:global>
    @import url('https://fonts.googleapis.com/css2?family=Outfit:wght@300;400;500;600;700&family=Sora:wght@500;600;700&display=swap');

    :root {
      color-scheme: light;
      --ink: #0f172a;
      --text: #1f2937;
      --muted: #64748b;
      --soft: #e2e8f0;
      --surface: #f8fafc;
      --accent: #0f766e;
      --accent-strong: #0f4c5c;
      --accent-soft: #ccfbf1;
      --highlight: #fbbf24;
    }

    * {
      margin: 0;
      padding: 0;
      box-sizing: border-box;
    }

    body {
      font-family: 'Outfit', system-ui, sans-serif;
      line-height: 1.6;
      color: var(--text);
      background: linear-gradient(180deg, #f8fafc 0%, #ffffff 50%, #f8fafc 100%);
    }

    h1, h2, h3, h4 {
      font-family: 'Sora', system-ui, sans-serif;
      color: var(--ink);
    }

    a {
      color: inherit;
    }

    .container {
      max-width: 1200px;
      margin: 0 auto;
      padding: 0 1.25rem;
    }

    .section {
      padding: 4.5rem 0;
    }

    .section-title {
      font-size: 2.4rem;
      margin-bottom: 0.75rem;
    }

    .section-subtitle {
      color: var(--muted);
      max-width: 680px;
      font-size: 1.05rem;
    }

    .stack {
      display: grid;
      gap: 2rem;
    }

    .card {
      background: #ffffff;
      border: 1px solid var(--soft);
      border-radius: 1.25rem;
      padding: 2rem;
      box-shadow: 0 18px 40px rgba(15, 23, 42, 0.08);
    }

    .pill {
      display: inline-flex;
      align-items: center;
      gap: 0.5rem;
      padding: 0.45rem 1rem;
      border-radius: 999px;
      background: rgba(255, 255, 255, 0.2);
      color: #ffffff;
      font-size: 0.85rem;
      font-weight: 600;
      letter-spacing: 0.02em;
    }

    .btn {
      display: inline-flex;
      align-items: center;
      justify-content: center;
      gap: 0.5rem;
      padding: 0.9rem 1.6rem;
      border-radius: 999px;
      font-weight: 600;
      text-decoration: none;
      transition: transform 0.2s ease, box-shadow 0.2s ease;
    }

    .btn-primary {
      background: var(--accent);
      color: #ffffff;
      box-shadow: 0 14px 30px rgba(15, 118, 110, 0.35);
    }

    .btn-secondary {
      background: #ffffff;
      color: var(--accent-strong);
      border: 1px solid rgba(15, 118, 110, 0.3);
    }

    .btn:hover {
      transform: translateY(-2px);
      box-shadow: 0 18px 40px rgba(15, 118, 110, 0.2);
    }

    .hero {
      position: relative;
      padding: 6rem 0 5rem;
      background: radial-gradient(circle at top left, #ccfbf1 0%, rgba(204, 251, 241, 0) 55%),
        radial-gradient(circle at top right, rgba(15, 118, 110, 0.2) 0%, rgba(15, 118, 110, 0) 55%),
        linear-gradient(130deg, #0f172a 0%, #0f4c5c 100%);
      color: #ffffff;
      overflow: hidden;
    }

    .hero::after {
      content: '';
      position: absolute;
      right: -120px;
      top: -120px;
      width: 320px;
      height: 320px;
      background: rgba(255, 255, 255, 0.08);
      border-radius: 50%;
    }

    .hero-grid {
      display: grid;
      gap: 2.5rem;
    }

    .hero h1 {
      font-size: 3.1rem;
      margin-bottom: 1rem;
    }

    .hero p {
      font-size: 1.1rem;
      color: rgba(255, 255, 255, 0.85);
      max-width: 560px;
    }

    .hero-actions {
      display: flex;
      flex-wrap: wrap;
      gap: 1rem;
      margin-top: 2rem;
    }

    .hero-cards {
      display: grid;
      gap: 1rem;
    }

    .hero-card {
      background: rgba(255, 255, 255, 0.12);
      border-radius: 1rem;
      padding: 1.25rem 1.5rem;
      border: 1px solid rgba(255, 255, 255, 0.2);
      backdrop-filter: blur(10px);
    }

    .hero-card h3 {
      font-size: 1rem;
      color: #ffffff;
      margin-bottom: 0.35rem;
    }

    .hero-card p {
      font-size: 0.95rem;
      color: rgba(255, 255, 255, 0.8);
    }

    .alert {
      background: linear-gradient(90deg, #991b1b, #dc2626);
      color: #ffffff;
      padding: 1rem 0;
    }

    .alert-inner {
      display: flex;
      flex-wrap: wrap;
      align-items: center;
      justify-content: space-between;
      gap: 1rem;
      font-weight: 600;
    }

    .alert a {
      color: #ffffff;
      text-decoration: none;
      border: 1px solid rgba(255, 255, 255, 0.4);
      padding: 0.55rem 1.2rem;
      border-radius: 999px;
    }

    .overview {
      display: grid;
      gap: 2rem;
      align-items: start;
    }

    .overview-body :global(h2),
    .overview-body :global(h3) {
      margin-top: 1.5rem;
      margin-bottom: 0.6rem;
    }

    .overview-body :global(p) {
      margin-bottom: 1rem;
      color: var(--text);
    }

    .overview-body :global(ul),
    .overview-body :global(ol) {
      margin-left: 1.25rem;
      margin-bottom: 1rem;
    }

    .stats-grid {
      display: grid;
      gap: 1rem;
    }

    .stat-tile {
      padding: 1.4rem;
      border-radius: 1rem;
      background: var(--surface);
      border: 1px solid var(--soft);
    }

    .stat-value {
      font-size: 1.6rem;
      font-weight: 700;
      color: var(--accent-strong);
      margin-bottom: 0.35rem;
    }

    .stat-label {
      color: var(--muted);
      font-weight: 500;
    }

    .grid-3 {
      display: grid;
      gap: 1.5rem;
    }

    .grid-2 {
      display: grid;
      gap: 1.5rem;
    }

    .tile {
      border-radius: 1rem;
      border: 1px solid var(--soft);
      padding: 1.5rem;
      background: #ffffff;
      transition: transform 0.2s ease, box-shadow 0.2s ease;
    }

    .tile:hover {
      transform: translateY(-4px);
      box-shadow: 0 16px 35px rgba(15, 23, 42, 0.12);
    }

    .doctor-grid {
      display: grid;
      gap: 1.5rem;
    }

    .doctor-card {
      border-radius: 1rem;
      border: 1px solid var(--soft);
      background: #ffffff;
      overflow: hidden;
      display: grid;
      grid-template-rows: auto 1fr;
      box-shadow: 0 14px 30px rgba(15, 23, 42, 0.08);
    }

    .doctor-photo {
      width: 100%;
      height: 220px;
      background: linear-gradient(135deg, #ccfbf1, #e0f2fe);
      display: flex;
      align-items: center;
      justify-content: center;
      font-size: 2.5rem;
      color: var(--accent);
    }

    .doctor-details {
      padding: 1.5rem;
      display: grid;
      gap: 0.5rem;
    }

    .doctor-details h3 {
      font-size: 1.15rem;
    }

    .doctor-specialty {
      color: var(--accent);
      font-weight: 600;
    }

    .doctor-credentials {
      color: var(--muted);
      font-size: 0.95rem;
    }

    .doctor-link {
      margin-top: 0.5rem;
      display: inline-flex;
      align-items: center;
      gap: 0.4rem;
      color: var(--accent-strong);
      text-decoration: none;
      font-weight: 600;
    }

    .tile h3 {
      font-size: 1.1rem;
      margin-bottom: 0.5rem;
    }

    .tile p {
      color: var(--muted);
      font-size: 0.95rem;
    }

    .tag-list {
      display: flex;
      flex-wrap: wrap;
      gap: 0.6rem;
    }

    .tag {
      background: var(--accent-soft);
      color: var(--accent-strong);
      padding: 0.45rem 0.9rem;
      border-radius: 999px;
      font-weight: 600;
      font-size: 0.9rem;
    }

    .info-grid {
      display: grid;
      gap: 1.5rem;
    }

    .info-card {
      border-radius: 1rem;
      border: 1px solid var(--soft);
      padding: 1.5rem;
      background: #ffffff;
    }

    .info-card h3 {
      font-size: 1rem;
      color: var(--muted);
      text-transform: uppercase;
      letter-spacing: 0.08em;
      margin-bottom: 0.75rem;
    }

    .info-card p {
      font-size: 1.05rem;
      font-weight: 600;
      color: var(--ink);
    }

    .map-frame {
      border-radius: 1.25rem;
      overflow: hidden;
      border: 1px solid var(--soft);
      background: var(--surface);
      min-height: 320px;
      display: flex;
      align-items: center;
      justify-content: center;
      text-align: center;
      padding: 2rem;
      color: var(--muted);
    }

    .cta {
      border-radius: 1.5rem;
      padding: 3.5rem 2.5rem;
      background: linear-gradient(130deg, rgba(15, 118, 110, 0.1), rgba(15, 76, 92, 0.2));
      border: 1px solid rgba(15, 118, 110, 0.2);
      text-align: center;
    }

    .cta h2 {
      font-size: 2.2rem;
      margin-bottom: 0.8rem;
    }

    .cta p {
      max-width: 560px;
      margin: 0 auto 1.8rem;
      color: var(--muted);
      font-size: 1.05rem;
    }

    .footer {
      padding: 2.5rem 0 3rem;
      border-top: 1px solid var(--soft);
      color: var(--muted);
    }

    .footer-grid {
      display: grid;
      gap: 1.5rem;
    }

    .footer h4 {
      font-size: 1rem;
      margin-bottom: 0.75rem;
    }

    .footer a {
      color: var(--muted);
      text-decoration: none;
      font-size: 0.95rem;
    }

    .footer a:hover {
      color: var(--accent);
    }

    .reveal {
      animation: fadeUp 0.6s ease both;
    }

    @keyframes fadeUp {
      from {
        opacity: 0;
        transform: translateY(16px);
      }
      to {
        opacity: 1;
        transform: translateY(0);
      }
    }

    @media (min-width: 768px) {
      .hero-grid {
        grid-template-columns: minmax(0, 1.3fr) minmax(0, 1fr);
        align-items: center;
      }

      .overview {
        grid-template-columns: minmax(0, 1.3fr) minmax(0, 1fr);
      }

      .stats-grid {
        grid-template-columns: repeat(2, minmax(0, 1fr));
      }

      .grid-2 {
        grid-template-columns: repeat(2, minmax(0, 1fr));
      }

      .grid-3 {
        grid-template-columns: repeat(3, minmax(0, 1fr));
      }

      .doctor-grid {
        grid-template-columns: repeat(3, minmax(0, 1fr));
      }

      .info-grid {
        grid-template-columns: repeat(2, minmax(0, 1fr));
      }

      .footer-grid {
        grid-template-columns: repeat(3, minmax(0, 1fr));
      }
    }
  </style>

  {showHero && (
    <section class="hero">
      <div class="container">
        <div class="hero-grid">
          <div>
            <span class="pill">Regional Medical Center</span>
            <h1>{title}</h1>
            <p>{heroTagline}</p>
            <div class="hero-actions">
              <a class="btn btn-primary" href={primaryCtaHref}>Book Appointment</a>
              <a class="btn btn-secondary" href={secondaryCtaHref}>Get Directions</a>
            </div>
          </div>
          <div class="hero-cards">
            <div class="hero-card reveal" style="animation-delay: 80ms;">
              <h3>Call us</h3>
              <p>{displayPhone}</p>
            </div>
            <div class="hero-card reveal" style="animation-delay: 160ms;">
              <h3>Location</h3>
              <p>{location}</p>
            </div>
            <div class="hero-card reveal" style="animation-delay: 240ms;">
              <h3>Visiting hours</h3>
              <p>{hoursValue}</p>
            </div>
          </div>
        </div>
      </div>
    </section>
  )}

  {showEmergency && emergencyLine && (
    <section class="alert">
      <div class="container">
        <div class="alert-inner">
          <span>Emergency care available 24/7</span>
          <a href="#contact">Emergency line: {emergencyLine}</a>
        </div>
      </div>
    </section>
  )}

  <main>
    {showOverview && (
      <section class="section">
      <div class="container">
        <div class="overview">
          <div class="overview-body card reveal">
            <h2 class="section-title">About {title}</h2>
            <slot />
          </div>
          {statsList.length > 0 && (
            <div class="stats-grid">
              {statsList.map((item, index) => (
                <div class="stat-tile reveal" style={`animation-delay: ${index * 120}ms`}>
                  <div class="stat-value">{item.value}</div>
                  <div class="stat-label">{item.label}</div>
                </div>
              ))}
            </div>
          )}
        </div>
      </div>
      </section>
    )}

    {showDepartments && departmentList.length > 0 && (
      <section class="section" id="departments">
        <div class="container stack">
          <div>
            <h2 class="section-title">Departments and services</h2>
            <p class="section-subtitle">Specialty care teams with clear referral pathways and coordinated follow up.</p>
          </div>
          <div class="grid-3">
            {departmentList.map((dept, index) => (
              <div class="tile reveal" style={`animation-delay: ${index * 100}ms`}>
                <h3>{dept.name}</h3>
                {dept.summary && <p>{dept.summary}</p>}
              </div>
            ))}
          </div>
        </div>
      </section>
    )}

    {showFacilities && facilityList.length > 0 && (
      <section class="section">
        <div class="container stack">
          <div>
            <h2 class="section-title">Facilities</h2>
            <p class="section-subtitle">Modern infrastructure designed for safe, efficient patient care.</p>
          </div>
          <div class="grid-3">
            {facilityList.map((item, index) => (
              <div class="tile reveal" style={`animation-delay: ${index * 90}ms`}>
                <h3>{item}</h3>
                <p>High quality clinical and patient support services.</p>
              </div>
            ))}
          </div>
        </div>
      </section>
    )}

    {showDiagnostics && diagnosticsList.length > 0 && (
      <section class="section">
        <div class="container stack">
          <div>
            <h2 class="section-title">Diagnostics</h2>
            <p class="section-subtitle">Integrated imaging and laboratory services for faster clinical decisions.</p>
          </div>
          <div class="tag-list">
            {diagnosticsList.map((item) => (
              <span class="tag">{item}</span>
            ))}
          </div>
        </div>
      </section>
    )}

    {((showInsurance && insuranceList.length > 0) || (showAccreditations && accreditationList.length > 0)) && (
      <section class="section">
        <div class="container grid-2">
          {showInsurance && insuranceList.length > 0 && (
            <div class="card reveal">
              <h2 class="section-title">Insurance and billing</h2>
              <p class="section-subtitle">Accepted plans and billing support.</p>
              <div class="tag-list" style="margin-top: 1.25rem;">
                {insuranceList.map((item) => (
                  <span class="tag">{item}</span>
                ))}
              </div>
            </div>
          )}
          {showAccreditations && accreditationList.length > 0 && (
            <div class="card reveal" style="animation-delay: 120ms;">
              <h2 class="section-title">Accreditations</h2>
              <p class="section-subtitle">Recognitions that reflect our safety and care standards.</p>
              <div class="tag-list" style="margin-top: 1.25rem;">
                {accreditationList.map((item) => (
                  <span class="tag">{item}</span>
                ))}
              </div>
            </div>
          )}
        </div>
      </section>
    )}

    {showDoctors && featuredDoctors?.length > 0 && (
      <section class="section" id="doctors">
        <div class="container stack">
          <div>
            <h2 class="section-title">Meet our doctors</h2>
            <p class="section-subtitle">Experienced specialists delivering coordinated care.</p>
          </div>
          <div class="doctor-grid grid-3">
            {featuredDoctors.map((doctor, index) => (
              <div class="doctor-card reveal" style={`animation-delay: ${index * 120}ms`}>
                <div class="doctor-photo">
                  {doctor.photo ? (
                    <img src={doctor.photo} alt={doctor.name} loading="lazy" style="width:100%;height:100%;object-fit:cover;" />
                  ) : (
                    <span>👩‍⚕️</span>
                  )}
                </div>
                <div class="doctor-details">
                  <h3>{doctor.name}</h3>
                  <div class="doctor-specialty">{doctor.specialty}</div>
                  {doctor.credentials && <div class="doctor-credentials">{doctor.credentials}</div>}
                  {doctor.profileUrl && (
                    <a class="doctor-link" href={doctor.profileUrl}>
                      View profile
                      <span aria-hidden="true">→</span>
                    </a>
                  )}
                </div>
              </div>
            ))}
          </div>
        </div>
      </section>
    )}

    {showContact && (
      <section class="section" id="contact">
        <div class="container stack">
          <div>
            <h2 class="section-title">Contact and visiting</h2>
            <p class="section-subtitle">All the essential details in one place.</p>
          </div>
          <div class="info-grid">
            <div class="info-card reveal">
              <h3>Main phone</h3>
              <p>{displayPhone}</p>
            </div>
            <div class="info-card reveal" style="animation-delay: 120ms;">
              <h3>Email</h3>
              <p>{displayEmail}</p>
            </div>
            <div class="info-card reveal" style="animation-delay: 240ms;">
              <h3>Visiting hours</h3>
              <p>{hoursValue}</p>
            </div>
            <div class="info-card reveal" style="animation-delay: 360ms;">
              <h3>Address</h3>
              <p>{location}</p>
            </div>
          </div>
        </div>
      </section>
    )}

    {showMap && (
      <section class="section" id="find-us">
        <div class="container stack">
          <div>
            <h2 class="section-title">Find us</h2>
            <p class="section-subtitle">Plan your visit with clear directions.</p>
          </div>
          {mapEmbed ? (
            <div class="map-frame">
              <iframe
                src={mapEmbed}
                width="100%"
                height="360"
                loading="lazy"
                style="border:0;"
                allowfullscreen
                referrerpolicy="no-referrer-when-downgrade"
              ></iframe>
            </div>
          ) : (
            <div class="map-frame">
              <div>
                <p>{title}</p>
                <p>{location}</p>
                <a class="btn btn-secondary" href={mapCtaHref} style="margin-top: 1rem;">Get directions</a>
              </div>
            </div>
          )}
        </div>
      </section>
    )}

    {showCta && (
      <section class="section">
        <div class="container">
          <div class="cta">
            <h2>Plan your visit today</h2>
            <p>Call our appointment desk or book online for faster scheduling.</p>
            <div class="hero-actions">
              <a class="btn btn-primary" href={primaryCtaHref}>Book Appointment</a>
              <a class="btn btn-secondary" href="#contact">Call {displayPhone}</a>
            </div>
          </div>
        </div>
      </section>
    )}
  </main>

  {showFooter && (
    <footer class="footer">
      <div class="container footer-grid">
        <div>
          <h4>{title}</h4>
          <p>{heroTagline}</p>
        </div>
        <div>
          <h4>Quick links</h4>
          <div class="stack" style="gap: 0.5rem;">
            <a href="#departments">Departments</a>
            <a href="#contact">Contact</a>
            <a href="#find-us">Directions</a>
          </div>
        </div>
        <div>
          <h4>Connect</h4>
          <div class="stack" style="gap: 0.5rem;">
            {socialList.length > 0 ? (
              socialList.map((item) => (
                <a href={item.url}>{item.label}</a>
              ))
            ) : (
              <span>Social links coming soon.</span>
            )}
          </div>
        </div>
      </div>
    </footer>
  )}
</BaseLayout>
