---
import BaseLayout from '../layouts/BaseLayout.astro';

// Every Open Care audience uses the same three plans: Free, Plus and Pro.
const plans = [
  {
    name: 'Free',
    tier: 'Directory',
    price: 'BDT 0',
    description: 'Be found in the Open Care hospital directory at no cost.',
    bestFor: 'Every registered hospital and clinic',
    sellPoint: 'A searchable listing with the essentials patients look for.',
    highlight: false,
    exampleUrl: '',
    exampleLabel: '',
    cta: 'Get started free',
    features: [
      'Listing in the Open Care directory',
      'Address, phone, facility type and registration code',
      'Emergency, ambulance and blood bank information (always free)',
      'Claimed and verified contact details — roadmap',
      'Appears in directory search, filters and the map',
      'Edit your listing in the Open Care console'
    ],
    updates: 'Self-service updates',
    sharing: 'Open Care directory link'
  },
  {
    name: 'Plus',
    tier: 'Foundation',
    price: 'Clinics and diagnostic centres BDT 1,500 · Hospitals BDT 3,000',
    description: 'A landing page with your services, tests and prices.',
    bestFor: 'Community hospitals and multi-specialty centers',
    sellPoint: 'Launch a credible, patient-friendly hospital presence fast.',
    highlight: false,
    exampleUrl: '/h/sunrise-medical-center',
    exampleLabel: 'View Plus demo (Sunrise)',
    cta: 'Talk to sales',
    features: [
      'Everything in Free',
      'Blood donor list access',
      'Hospital hero, overview, and contact blocks',
      'Departments and services listing',
      'Test list with prices and report turnaround',
      'Map + directions CTA',
      'Basic SEO (title + description)',
      'SMS and email alerts for patient enquiries — roadmap'
    ],
    updates: 'Quarterly content updates',
    sharing: 'Shareable hospital URL'
  },
  {
    name: 'Pro',
    tier: 'Growth',
    price: 'Clinics and diagnostic centres BDT 3,000 · Hospitals BDT 5,000',
    description: 'More patients reach you, and you can see how.',
    bestFor: 'Regional hospitals and referral centers',
    sellPoint: 'More clarity for patients, stronger referral conversion.',
    highlight: true,
    exampleUrl: '/h/harborview-medical',
    exampleLabel: 'View Pro demo (Harborview)',
    cta: 'Talk to sales',
    features: [
      'Everything in Plus',
      'Featured doctors section',
      'Insurance and accreditation badges',
      'Hospital stats and performance highlights',
      'Enquiry analytics: views, calls, directions — roadmap',
      'Priority placement in public search, labelled as featured — roadmap'
    ],
    updates: 'Monthly content updates',
    sharing: 'Shareable hospital URL + promo assets'
  }
];

const comparison = [
  { label: 'Directory listing', free: 'Yes', plus: 'Yes', pro: 'Yes' },
  { label: 'Blood donor list access', free: '—', plus: 'Yes', pro: 'Yes' },
  { label: 'Hospital landing page', free: '—', plus: 'Yes', pro: 'Yes' },
  { label: 'Departments and services', free: '—', plus: 'Yes', pro: 'Yes' },
  { label: 'Test list with prices', free: '—', plus: 'Yes', pro: 'Yes' },
  { label: 'Emergency, ambulance, blood bank details', free: 'Yes', plus: 'Yes', pro: 'Yes' },
  { label: 'Claimed and verified contact details', free: 'Roadmap', plus: 'Roadmap', pro: 'Roadmap' },
  { label: 'Map + directions CTA', free: '—', plus: 'Yes', pro: 'Yes' },
  { label: 'Featured doctors', free: '—', plus: '—', pro: 'Yes' },
  { label: 'Insurance and accreditations', free: '—', plus: '—', pro: 'Yes' },
  { label: 'Hospital stats highlights', free: '—', plus: '—', pro: 'Yes' },
  { label: 'Update frequency', free: 'Self-service', plus: 'Quarterly', pro: 'Monthly' },
  { label: 'Live demo', free: '—', plus: 'Sunrise', pro: 'Harborview' }
];
---
<BaseLayout title="Hospital Pricing" description="Free, Plus and Pro plans for Open Care hospitals.">
  <main class="relative overflow-hidden">
    <div class="absolute -top-32 right-0 h-72 w-72 rounded-full bg-sun/40 blur-3xl"></div>
    <div class="absolute -bottom-20 left-10 h-72 w-72 rounded-full bg-moss/20 blur-3xl"></div>

    <section class="mx-auto w-full max-w-6xl px-6 pb-12 pt-16">
      <div class="grid gap-10 lg:grid-cols-[1.1fr_0.9fr] lg:items-center">
        <div class="space-y-6">
          <p class="text-sm font-semibold uppercase tracking-[0.25em] text-moss">Hospital Pricing</p>
          <h1 class="text-4xl font-serif font-semibold text-ink sm:text-5xl">
            Pricing for hospital pages built to earn patient confidence.
          </h1>
          <p class="text-lg text-ink/70">
            Choose a plan based on the depth of service detail, featured specialists, and ongoing content support
            you need.
          </p>
          <div class="flex flex-wrap gap-3">
            <a
              href="mailto:hello@opencare.com"
              class="rounded-full bg-moss px-5 py-2 text-sm font-semibold text-white shadow-sm"
            >
              Request pricing
            </a>
            <a
              href="/pricing/doctor"
              class="rounded-full border border-ink/15 px-5 py-2 text-sm font-semibold text-ink/80"
            >
              Doctor pricing
            </a>
          </div>
        </div>
        <div class="rounded-3xl border border-ink/10 bg-white/80 p-6 shadow-sm">
          <h2 class="text-lg font-semibold text-ink">Included in every hospital plan</h2>
          <ul class="mt-4 space-y-3 text-sm text-ink/70">
            <li>Astro-powered performance and SEO-ready markup</li>
            <li>No backend dependency (low maintenance)</li>
            <li>Editable via Markdown content</li>
            <li>Mobile-first, trust-forward design</li>
          </ul>
        </div>
      </div>
    </section>

    <section class="mx-auto w-full max-w-6xl px-6 pb-16">
      <div class="grid gap-6 lg:grid-cols-3">
        {plans.map((plan) => (
          <article
            class={[
              'rounded-3xl border p-6 shadow-sm',
              plan.highlight
                ? 'border-moss/40 bg-white'
                : 'border-ink/10 bg-white/70'
            ].join(' ')}
          >
            <div class="flex items-center justify-between">
              <div>
                <p class="text-sm uppercase tracking-[0.2em] text-ink/50">{plan.tier}</p>
                <h3 class="text-2xl font-semibold text-ink">{plan.name}</h3>
              </div>
              {plan.highlight && (
                <span class="rounded-full bg-moss/10 px-3 py-1 text-xs font-semibold text-moss">
                  Most popular
                </span>
              )}
            </div>
            <p class="mt-4 text-sm text-ink/70">{plan.description}</p>
            <p class="mt-4 text-2xl font-semibold text-ink">{plan.price}</p>
            <div class="mt-4 text-sm text-ink/60">
              <p><span class="font-semibold text-ink">Best for:</span> {plan.bestFor}</p>
              <p><span class="font-semibold text-ink">Sellable point:</span> {plan.sellPoint}</p>
            </div>
            <div class="mt-5 space-y-2 text-sm text-ink/70">
              <p><span class="font-semibold text-ink">Update frequency:</span> {plan.updates}</p>
              <p><span class="font-semibold text-ink">Sharing:</span> {plan.sharing}</p>
            </div>
            <ul class="mt-5 space-y-2 text-sm text-ink/70">
              {plan.features.map((item) => (
                <li class="flex gap-2">
                  <span class="mt-1 h-2 w-2 rounded-full bg-moss/60"></span>
                  <span>{item}</span>
                </li>
              ))}
            </ul>
            <div class="mt-6 grid gap-3">
              {plan.exampleUrl && (
                <a
                  href={plan.exampleUrl}
                  class="inline-flex w-full items-center justify-center rounded-full border border-ink/15 px-4 py-2 text-sm font-semibold text-ink"
                >
                  {plan.exampleLabel}
                </a>
              )}
              <a
                href="mailto:hello@opencare.com"
                class={[
                  'inline-flex w-full items-center justify-center rounded-full px-4 py-2 text-sm font-semibold',
                  plan.highlight ? 'bg-moss text-white' : 'border border-ink/15 text-ink'
                ].join(' ')}
              >
                {plan.cta}
              </a>
            </div>
          </article>
        ))}
      </div>
    </section>

    <section class="mx-auto w-full max-w-6xl px-6 pb-16">
      <div class="rounded-3xl border border-ink/10 bg-white/80 p-6 shadow-sm">
        <h2 class="text-2xl font-serif font-semibold text-ink">Feature comparison</h2>
        <div class="mt-6 overflow-x-auto">
          <table class="w-full text-left text-sm text-ink/70">
            <thead>
              <tr class="border-b border-ink/10 text-xs uppercase tracking-[0.2em] text-ink/50">
                <th class="py-3">Feature</th>
                <th class="py-3">Free</th>
                <th class="py-3">Plus</th>
                <th class="py-3">Pro</th>
              </tr>
            </thead>
            <tbody>
              {comparison.map((row) => (
                <tr class="border-b border-ink/5">
                  <td class="py-3 font-medium text-ink">{row.label}</td>
                  <td class="py-3">{row.free}</td>
                  <td class="py-3">
                    {row.label === 'Live demo' ? (
                      <a class="underline underline-offset-4" href="/h/sunrise-medical-center">{row.plus}</a>
                    ) : row.plus}
                  </td>
                  <td class="py-3">
                    {row.label === 'Live demo' ? (
                      <a class="underline underline-offset-4" href="/h/harborview-medical">{row.pro}</a>
                    ) : row.pro}
                  </td>
                </tr>
              ))}
            </tbody>
          </table>
        </div>
        <p class="mt-4 text-sm text-ink/70">
          Hospital networks and flagship campuses that need custom brand styling, campaign sections or network landing pages:
          <a class="underline underline-offset-4" href="mailto:hello@opencare.com">contact us for a custom plan</a>.
        </p>
        <p class="mt-4 text-xs text-ink/50">
          Roadmap items are planned for upcoming releases. We will notify you before they go live.
        </p>
      </div>
    </section>
  </main>
</BaseLayout>
