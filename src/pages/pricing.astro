---
import BaseLayout from '../layouts/BaseLayout.astro';
---
<BaseLayout title="Pricing" description="Choose a pricing track for doctor or hospital pages.">
  <main class="mx-auto w-full max-w-5xl px-6 py-16 text-ink">
    <section class="space-y-6">
      <div class="space-y-3">
        <p class="text-sm font-semibold uppercase tracking-[0.2em] text-moss">Pricing</p>
        <h1 class="text-4xl font-serif font-semibold">Choose your pricing track.</h1>
        <p class="text-lg text-ink/70">
          Free, Plus and Pro plans for patients, doctors and hospitals.
        </p>
      </div>
      <div class="grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
        <a class="rounded-3xl border border-ink/10 bg-white/80 p-6 shadow-sm transition hover:border-ink/30" href="/pricing/patient">
          <p class="text-sm uppercase tracking-[0.2em] text-ink/60">Patient pricing</p>
          <p class="mt-2 text-xl font-semibold">Plans for patients</p>
          <p class="mt-2 text-sm text-ink/70">Free care access, with report storage, report analysis and video consultation to come.</p>
        </a>
        <a class="rounded-3xl border border-ink/10 bg-white/80 p-6 shadow-sm transition hover:border-ink/30" href="/pricing/doctor">
          <p class="text-sm uppercase tracking-[0.2em] text-ink/60">Doctor pricing</p>
          <p class="mt-2 text-xl font-semibold">Plans for doctors</p>
          <p class="mt-2 text-sm text-ink/70">Turn profile views into booked visits.</p>
        </a>
        <a class="rounded-3xl border border-ink/10 bg-white/80 p-6 shadow-sm transition hover:border-ink/30" href="/hospital">
          <p class="text-sm uppercase tracking-[0.2em] text-ink/60">Hospital pricing</p>
          <p class="mt-2 text-xl font-semibold">Plans for hospitals</p>
          <p class="mt-2 text-sm text-ink/70">Highlight departments, diagnostics, and trust signals.</p>
        </a>
      </div>
    </section>
  </main>
</BaseLayout>
