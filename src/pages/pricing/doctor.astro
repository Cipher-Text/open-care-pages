---
import BaseLayout from '../../layouts/BaseLayout.astro';

const plans = [
  {
    name: 'Silver',
    tier: 'Starter',
    price: 'BDT 1,000',
    description: 'Launch fast with a clean, credible profile.',
    bestFor: 'New practices and solo doctors',
    sellPoint: 'Fastest time-to-publish with a professional footprint.',
    highlight: false,
    exampleUrl: '/d/dr-silver',
    exampleLabel: 'View Silver demo (Dr. Silver)',
    features: [
      'Doctor landing page (hero, about, contact)',
      'WhatsApp pre-filled booking link',
      'Trust chips + verification badges',
      'Single primary practice location',
      'Basic SEO (title + description)'
    ],
    updates: 'Quarterly content updates',
    sharing: 'Shareable page URL'
  },
  {
    name: 'Gold',
    tier: 'Growth',
    price: 'BDT 2,000',
    description: 'Conversion-focused features that book more patients.',
    bestFor: 'Busy clinics that need steady bookings',
    sellPoint: 'Highest conversion mix without backend complexity.',
    highlight: true,
    exampleUrl: '/d/dr-gold',
    exampleLabel: 'View Gold demo (Dr. Gold)',
    features: [
      'Everything in Silver',
      'QR code download + vCard download',
      'Quick booking block (CTA cluster)',
      'Multiple practice locations & schedules',
      'Reviews + FAQ sections',
      'Language toggle (EN/BN)'
    ],
    updates: 'Monthly content updates',
    sharing: 'QR + vCard + WhatsApp'
  },
  {
    name: 'Diamond',
    tier: 'Signature',
    price: 'BDT 3,000',
    description: 'Premium trust and distribution assets.',
    bestFor: 'High-volume specialists and flagship clinics',
    sellPoint: 'Brand-grade assets for referral and outreach.',
    highlight: false,
    exampleUrl: '',
    exampleLabel: 'Request Diamond demo',
    features: [
      'Everything in Gold',
      'Printable visiting card (PDF) — roadmap',
      'Shareable profile poster — roadmap',
      'Downloadable profile one-pager — roadmap',
      'Structured data (JSON-LD) — roadmap'
    ],
    updates: 'Bi-weekly content updates',
    sharing: 'Poster + PDF + QR assets (roadmap)'
  }
];

const comparison = [
  { label: 'Profile page', silver: 'Yes', gold: 'Yes', diamond: 'Yes' },
  { label: 'WhatsApp pre-filled CTA', silver: 'Yes', gold: 'Yes', diamond: 'Yes' },
  { label: 'QR code & vCard', silver: '—', gold: 'Yes', diamond: 'Yes' },
  { label: 'Multiple locations', silver: '1 location', gold: 'Unlimited', diamond: 'Unlimited' },
  { label: 'Reviews & FAQs', silver: '—', gold: 'Yes', diamond: 'Yes' },
  { label: 'Language toggle (EN/BN)', silver: '—', gold: 'Yes', diamond: 'Yes' },
  { label: 'Shareable poster', silver: '—', gold: '—', diamond: 'Roadmap' },
  { label: 'Printable visiting card', silver: '—', gold: '—', diamond: 'Roadmap' },
  { label: 'Profile PDF one-pager', silver: '—', gold: '—', diamond: 'Roadmap' },
  { label: 'Update frequency', silver: 'Quarterly', gold: 'Monthly', diamond: 'Bi-weekly' },
  { label: 'Live demo', silver: 'Silver: Dr. Silver', gold: 'Gold: Dr. Gold', diamond: 'On request' }
];
---
<BaseLayout title="Doctor Pricing" description="Flexible plans for Open Care doctor pages.">
  <main class="relative overflow-hidden">
    <div class="absolute -top-32 right-0 h-72 w-72 rounded-full bg-sun/40 blur-3xl"></div>
    <div class="absolute -bottom-20 left-10 h-72 w-72 rounded-full bg-moss/20 blur-3xl"></div>

    <section class="mx-auto w-full max-w-6xl px-6 pb-12 pt-16">
      <div class="grid gap-10 lg:grid-cols-[1.1fr_0.9fr] lg:items-center">
        <div class="space-y-6">
          <p class="text-sm font-semibold uppercase tracking-[0.25em] text-moss">Doctor Pricing</p>
          <h1 class="text-4xl font-serif font-semibold text-ink sm:text-5xl">
            Plans designed to turn profile views into booked visits.
          </h1>
          <p class="text-lg text-ink/70">
            Pick a plan based on how often you update information, how widely you share, and the level
            of trust assets you want patients to see.
          </p>
          <div class="flex flex-wrap gap-3">
            <a
              href="mailto:hello@opencare.com"
              class="rounded-full bg-moss px-5 py-2 text-sm font-semibold text-white shadow-sm"
            >
              Request pricing
            </a>
            <a
              href="/hospital"
              class="rounded-full border border-ink/15 px-5 py-2 text-sm font-semibold text-ink/80"
            >
              Hospital pricing
            </a>
          </div>
        </div>
        <div class="rounded-3xl border border-ink/10 bg-white/80 p-6 shadow-sm">
          <h2 class="text-lg font-semibold text-ink">What you get with every plan</h2>
          <ul class="mt-4 space-y-3 text-sm text-ink/70">
            <li>Astro-powered performance and SEO-ready markup</li>
            <li>No backend dependency (low maintenance)</li>
            <li>Editable via Markdown content</li>
            <li>Mobile-first design and trust-first layout</li>
          </ul>
        </div>
      </div>
    </section>

    <section class="mx-auto w-full max-w-6xl px-6 pb-16">
      <div class="grid gap-6 lg:grid-cols-3">
        {plans.map((plan) => (
          <article
            class={[
              'rounded-3xl border p-6 shadow-sm',
              plan.highlight
                ? 'border-moss/40 bg-white'
                : 'border-ink/10 bg-white/70'
            ].join(' ')}
          >
            <div class="flex items-center justify-between">
              <div>
                <p class="text-sm uppercase tracking-[0.2em] text-ink/50">{plan.tier}</p>
                <h3 class="text-2xl font-semibold text-ink">{plan.name}</h3>
              </div>
              {plan.highlight && (
                <span class="rounded-full bg-moss/10 px-3 py-1 text-xs font-semibold text-moss">
                  Most popular
                </span>
              )}
            </div>
            <p class="mt-4 text-sm text-ink/70">{plan.description}</p>
            <p class="mt-4 text-2xl font-semibold text-ink">{plan.price}</p>
            <div class="mt-4 text-sm text-ink/60">
              <p><span class="font-semibold text-ink">Best for:</span> {plan.bestFor}</p>
              <p><span class="font-semibold text-ink">Sellable point:</span> {plan.sellPoint}</p>
            </div>
            <div class="mt-5 space-y-2 text-sm text-ink/70">
              <p><span class="font-semibold text-ink">Update frequency:</span> {plan.updates}</p>
              <p><span class="font-semibold text-ink">Sharing:</span> {plan.sharing}</p>
            </div>
            <ul class="mt-5 space-y-2 text-sm text-ink/70">
              {plan.features.map((item) => (
                <li class="flex gap-2">
                  <span class="mt-1 h-2 w-2 rounded-full bg-moss/60"></span>
                  <span>{item}</span>
                </li>
              ))}
            </ul>
            <div class="mt-6 grid gap-3">
              {plan.exampleUrl ? (
                <a
                  href={plan.exampleUrl}
                  class="inline-flex w-full items-center justify-center rounded-full border border-ink/15 px-4 py-2 text-sm font-semibold text-ink"
                >
                  {plan.exampleLabel}
                </a>
              ) : (
                <a
                  href="mailto:hello@opencare.com"
                  class="inline-flex w-full items-center justify-center rounded-full border border-ink/15 px-4 py-2 text-sm font-semibold text-ink"
                >
                  {plan.exampleLabel}
                </a>
              )}
              <a
                href="mailto:hello@opencare.com"
                class={[
                  'inline-flex w-full items-center justify-center rounded-full px-4 py-2 text-sm font-semibold',
                  plan.highlight ? 'bg-moss text-white' : 'border border-ink/15 text-ink'
                ].join(' ')}
              >
                Talk to sales
              </a>
            </div>
          </article>
        ))}
      </div>
    </section>

    <section class="mx-auto w-full max-w-6xl px-6 pb-16">
      <div class="rounded-3xl border border-ink/10 bg-white/80 p-6 shadow-sm">
        <h2 class="text-2xl font-serif font-semibold text-ink">Feature comparison</h2>
        <div class="mt-6 overflow-x-auto">
          <table class="w-full text-left text-sm text-ink/70">
            <thead>
              <tr class="border-b border-ink/10 text-xs uppercase tracking-[0.2em] text-ink/50">
                <th class="py-3">Feature</th>
                <th class="py-3">Silver</th>
                <th class="py-3">Gold</th>
                <th class="py-3">Diamond</th>
              </tr>
            </thead>
            <tbody>
              {comparison.map((row) => (
                <tr class="border-b border-ink/5">
                  <td class="py-3 font-medium text-ink">{row.label}</td>
                  <td class="py-3">
                    {row.label === 'Live demo' ? (
                      <a class="underline underline-offset-4" href="/d/dr-silver">Silver: Dr. Silver</a>
                    ) : row.silver}
                  </td>
                  <td class="py-3">
                    {row.label === 'Live demo' ? (
                      <a class="underline underline-offset-4" href="/d/dr-gold">Gold: Dr. Gold</a>
                    ) : row.gold}
                  </td>
                  <td class="py-3">{row.diamond}</td>
                </tr>
              ))}
            </tbody>
          </table>
        </div>
        <p class="mt-4 text-xs text-ink/50">
          Roadmap items are planned for upcoming releases. We will notify you before they go live.
        </p>
      </div>
    </section>
  </main>
</BaseLayout>
